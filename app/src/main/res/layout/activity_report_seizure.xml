<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout_report_seizure"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#E0EDEA"
    tools:context="uk.org.openseizuredetector.LogManager">

    <LinearLayout
        android:id="@+id/report_seizure_content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin">


        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_seizure"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColor="#172121"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Date Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#d9d6d2"
                    android:padding="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/date"
                        android:textColor="#172121"
                        android:layout_marginRight="8dp" />

                    <TextView
                        android:id="@+id/date_day_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="dd"
                        android:textColor="#172121"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="/"
                        android:textColor="#172121" />

                    <TextView
                        android:id="@+id/date_mon_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="mm"
                        android:textColor="#172121"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="/"
                        android:textColor="#172121" />

                    <TextView
                        android:id="@+id/date_year_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="yyyy"
                        android:textColor="#172121"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/select_date_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_date"
                        android:backgroundTint="#6A8D92" />
                </LinearLayout>

                <!-- Time Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#d9d6d2"
                    android:padding="8dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/time"
                        android:textColor="#172121"
                        android:layout_marginRight="8dp" />

                    <TextView
                        android:id="@+id/time_hh_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="hh"
                        android:textColor="#172121"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text=":"
                        android:textColor="#172121" />

                    <TextView
                        android:id="@+id/time_mm_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="mm"
                        android:textColor="#172121" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/select_time_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_time"
                        android:backgroundTint="#6A8D92" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/event_type"
                    android:textColor="#172121"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/eventTypeRg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" >

                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/event_sub_type"
                    android:textColor="#172121"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/eventSubTypeRg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginBottom="16dp" />


                <EditText
                    android:id="@+id/eventNotesTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="#d9d6d2"
                    android:hint="Notes about event"
                    android:padding="12dp"
                    android:textColor="#172121" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/loginBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/okBtnTxt"
                        android:backgroundTint="#6A8D92"
                        android:layout_marginRight="4dp" />

                    <Button
                        android:id="@+id/cancelBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cancelBtnTxt"
                        android:backgroundTint="#6A8D92"
                        android:layout_marginLeft="4dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="#6A8D92" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="Bulk Import Seizures"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textColor="#172121"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="# seizure_time,note\n2025-12-03 20:36:00,startle"
                    android:textSize="12sp"
                    android:textColor="#664E4C"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/bulkSeizureInput"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:gravity="top"
                    android:hint="Paste bulk seizure data here..."
                    android:inputType="textMultiLine"
                    android:scrollbars="vertical"
                    android:textColor="#172121"
                    android:textColorHint="#664E4C"
                    android:background="#d9d6d2"
                    android:padding="12dp" />

                <Button
                    android:id="@+id/bulkImportBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bulk Import"
                    android:backgroundTint="#6A8D92"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/msg_tv"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="msg"
                    android:textColor="#172121"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>